# ============================================================
#  UGC FLOW STUDIO - Konfigurasi
#  Copy file ini menjadi .env lalu isi sesuai akun kamu.
#  (Launcher KLIK-DISINI-UNTUK-MULAI.bat membuat .env otomatis.)
#  Semua nilai juga bisa diubah dari halaman Settings di web.
#  Kalau nilai di .env diubah, nilai baru dipakai saat server
#  dinyalakan ulang (menimpa nilai lama di Settings).
#  Baris yang diawali # adalah catatan (tidak dibaca).
# ============================================================

# --- Server ---
PORT=8787
HOST=0.0.0.0
APP_NAME=UGC Flow Studio
# Zona waktu untuk jadwal automation (contoh: Asia/Jakarta, Asia/Makassar, Asia/Jayapura)
TIMEZONE=Asia/Jakarta

# Buka browser otomatis saat server nyala (launcher Windows sudah mengaktifkan ini)
OPEN_BROWSER=
# Folder Downloads untuk auto-import video hasil Flow (kosong = deteksi otomatis)
DOWNLOADS_DIR=
# Tunggu berapa detik setelah download Flow terakhir sebelum mulai render
# (supaya beberapa klip yang di-download berurutan digabung jadi 1 video)
FLOW_INGEST_SETTLE_SECONDS=20
# Batas ukuran upload per file (MB)
MAX_UPLOAD_MB=2048

# --- Keamanan ---
# Secara default website lain TIDAK bisa memakai API studio ini dari browser kamu.
# Yang selalu boleh: localhost, alamat IP, nama PC, domain .local/.lan, Google Flow & ekstensi.
# Pakai tunnel / domain sendiri (ngrok, cloudflared, dll)? Tulis domainnya di sini (pisahkan koma):
ALLOWED_HOSTS=
# Website lain yang boleh memanggil API (CORS), contoh: https://studio.domainkamu.com
CORS_ORIGINS=

# --- Login (opsional, kosongkan kalau dipakai lokal sendiri) ---
# Wajib diaktifkan kalau server dibuka dari internet / jaringan lain.
AUTH_ENABLED=false
AUTH_USER=admin
AUTH_PASSWORD=

# --- Render ---
# Resolusi default: 480 | 720 | 1080 | 1440 (2K) | 2160 (4K)
RENDER_RESOLUTION=1080
RENDER_FPS=30
# Preset x264: ultrafast | veryfast | faster | fast | medium | slow (makin lambat = file makin kecil)
RENDER_PRESET=veryfast
# Kualitas (CRF 16-30, makin kecil makin bagus & besar filenya)
RENDER_CRF=21
# Jumlah render yang jalan bersamaan
QUEUE_CONCURRENCY=2
# Berapa kali job gagal dicoba ulang otomatis
QUEUE_MAX_RETRIES=1
# Lokasi ffmpeg sendiri (kosong = otomatis: tools\ffmpeg lalu PATH sistem)
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# ============================================================
#  FLOW ULTRA (generate video + generate gambar)
# ============================================================
# provider: simulate = jalan offline pakai ffmpeg (buat tes tanpa API)
#           flow     = panggil API akun Flow Ultra kamu
FLOW_PROVIDER=simulate
FLOW_BASE_URL=
FLOW_API_KEY=
FLOW_VIDEO_MODEL=flow-ultra-video
FLOW_IMAGE_MODEL=flow-ultra-image

# Lane default: low = LOWER PRIORITY (unlimited di akun Ultra), standard = prioritas normal
FLOW_DEFAULT_LANE=low
# Kalau kuota standard habis, otomatis pindah ke lane low (unlimited)
FLOW_AUTO_FALLBACK_LOW=true
# Jumlah job paralel per lane
FLOW_LOW_CONCURRENCY=2
FLOW_STANDARD_CONCURRENCY=1
# Batas harian lane standard (0 = unlimited). Lane low selalu unlimited.
FLOW_STANDARD_DAILY_LIMIT=50

# ============================================================
#  VOICE / TTS (ubah suara jadi natural)
# ============================================================
# provider: fishaudio | google | simulate | elevenlabs | openai | custom
#   fishaudio = Fish Audio (bagus untuk bahasa Indonesia, butuh FISHAUDIO_API_KEY)
#   google    = Google TTS gratis (butuh internet, tanpa API key)
#   simulate  = otomatis: Fish Audio kalau FISHAUDIO_API_KEY diisi, kalau tidak Google gratis
# Kalau API key provider kosong, suara otomatis turun ke Google TTS gratis
# (lalu nada placeholder kalau offline), jadi render tidak pernah gagal karena suara.
TTS_PROVIDER=fishaudio
# Fish Audio: ambil API key di https://fish.audio (menu API Keys)
FISHAUDIO_API_KEY=
# ID suara (reference_id, 32 karakter) dari halaman model/voice di fish.audio
FISHAUDIO_VOICE_ID=1b0b8ad55c6d49db94e1a9eadf6f4643
# (Opsional) voice kedua untuk Host B di Podcast AI supaya 2 host beda suara
FISHAUDIO_VOICE_ID_2=
# Simpan hasil TTS ke folder cache/ supaya tidak menghabiskan kredit (1 = aktif, 0 = nonaktif)
TTS_CACHE=1
TTS_BASE_URL=https://api.fish.audio/v1/tts
# Untuk elevenlabs / openai / custom isi TTS_API_KEY (Fish Audio cukup FISHAUDIO_API_KEY)
TTS_API_KEY=
# Model TTS. Fish Audio: kosong = default akun, atau mis. s1 / speech-1.6
# OpenAI: gpt-4o-mini-tts / tts-1. ElevenLabs: eleven_multilingual_v2
TTS_MODEL=
# Voice default untuk ElevenLabs / OpenAI / custom (Fish Audio memakai FISHAUDIO_VOICE_ID)
TTS_DEFAULT_VOICE=
# Naturalizer chain (EQ + de-esser + compressor + loudness R128)
TTS_NATURALIZE=true

# ============================================================
#  LLM (script hook / caption / hashtag). local = template bawaan
# ============================================================
# provider: local | remote
#   local  = generator template bawaan (offline, gratis)
#   remote = API apa saja yang kompatibel OpenAI /chat/completions
#            (OpenAI, OpenRouter, Groq, DeepSeek, Ollama lokal, dll)
# Kalau LLM_PROVIDER dikosongkan tapi LLM_BASE_URL + LLM_API_KEY diisi -> otomatis remote.
# Contoh OpenAI: LLM_PROVIDER=remote  LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
# Kalau API remote gagal / habis kuota, skrip otomatis dibuat pakai template lokal.
LLM_PROVIDER=local
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ============================================================
#  LIVE STREAMING 24 JAM
# ============================================================
# Cukup tempel Stream Key dari YouTube Studio ke halaman Live 24/7
# (atau isi di sini supaya jadi default semua channel).
YT_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
YT_STREAM_KEY=
# auto = copy kalau semua video formatnya sama (hemat CPU), encode ulang kalau beda
# copy = selalu copy, encode = selalu encode ulang
STREAM_MODE=auto
STREAM_VIDEO_BITRATE=4500k
STREAM_AUDIO_BITRATE=128k
STREAM_FPS=30
# 480 | 720 | 1080 | 1440 | 2160 (4K butuh bitrate +-20000k dan upload kencang)
STREAM_RESOLUTION=1080

# --- Notifikasi (opsional) ---
# URL yang dipanggil (POST JSON) setiap job selesai / gagal, mis. webhook n8n / Discord
NOTIFY_WEBHOOK_URL=
